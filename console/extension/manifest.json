{
  "manifest_version": 3,
  "name": "Swarm Browser",
  "version": "0.2.1",
  "description": "Lets the Swarm Orchestrator use this browser through Swarm Console, only inside a lease you grant per session.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "scripting", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Swarm Browser", "default_popup": "popup.html" }
}
