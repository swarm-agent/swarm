{
  "name": "@swarm/sdk",
  "version": "0.1.0-headless.1",
  "description": "Official TypeScript SDK for Swarm local AI coding workspace",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples/headless-session.ts",
    "README.md",
    "APPLICATIONS.md",
    "HEADLESS_UI.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "tsx --test --test-concurrency=1 ./src/__tests__/*.spec.ts"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "ws": "8.18.3" },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "swarm",
    "sdk",
    "ai",
    "agents",
    "automation",
    "workers"
  ],
  "author": "Swarm Team",
  "license": "Apache-2.0"
}
