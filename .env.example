# Non-secret local testbench connection settings only.
# Copy to .env; .env is ignored by Git. Never add tokens, passwords, cookies,
# private keys, API keys, credentials, or provider payloads here.
SWARM_PRIMARY_SSH=testbench
# Live candidate testing is container-only. The fixed broker exposes the isolated
# systemd-nspawn Desktop/API on remote loopback 5655/7881. Host 5555/7781 is not
# a candidate test target and the checked-in wrappers fail closed if configured.
SWARM_TESTBENCH_TARGET=container
SWARM_TESTBENCH_LOCAL_DESKTOP_PORT=15655
SWARM_REMOTE_DESKTOP_PORT=5655
SWARM_TESTBENCH_LOCAL_API_PORT=17881
SWARM_TESTBENCH_REMOTE_API_PORT=7881
# Testbench live tests are Fireworks-only. Every role is explicit and must use
# an exact Fireworks catalog model ID; runners fail closed rather than selecting
# recommendations or falling back to a different provider.
SWARM_TESTBENCH_PROVIDER=fireworks
SWARM_TESTBENCH_MODEL=deepseek-v4-flash-0731
SWARM_TESTBENCH_THINKING=high
SWARM_TESTBENCH_ACTION_MODEL=deepseek-v4-flash-0731
SWARM_TESTBENCH_ACTION_THINKING=high
SWARM_TESTBENCH_PLAN_MODEL=deepseek-v4-pro-0813
SWARM_TESTBENCH_PLAN_THINKING=xhigh
SWARM_TESTBENCH_CODER_MODEL=deepseek-v4-flash-0731
SWARM_TESTBENCH_CODER_THINKING=high
SWARM_TESTBENCH_DESIGNER_MODEL=kimi-k3
SWARM_TESTBENCH_DESIGNER_THINKING=high
# Optional second already-bound repository path for multi-repository runners.
SWARM_TESTBENCH_LINKED_WORKSPACE_PATH=

# Optional: expose one local loopback listener to the remote testbench over the
# same SSH process. Leave both empty unless the E2E scenario requires a callback.
SWARM_TESTBENCH_REVERSE_LOCAL_PORT=
SWARM_TESTBENCH_REVERSE_REMOTE_PORT=
