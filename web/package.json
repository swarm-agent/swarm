  "scripts": {
    "dev": "node ./scripts/use-local-node.mjs ./scripts/vite-launcher.mjs",
    "build": "node ./scripts/use-local-node.mjs ./node_modules/typescript/bin/tsc -b && node ./scripts/use-local-node.mjs ./scripts/vite-launcher.mjs build",
    "preview": "node ./scripts/use-local-node.mjs ./scripts/vite-launcher.mjs preview",
