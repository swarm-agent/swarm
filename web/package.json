{
  "name": "swarm-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/use-local-node.mjs ./scripts/vite-launcher.mjs",
    "build": "node ./scripts/use-local-node.mjs ./node_modules/typescript/bin/tsc -b && node ./scripts/use-local-node.mjs ./scripts/vite-launcher.mjs build",
    "preview": "node ./scripts/use-local-node.mjs ./scripts/vite-launcher.mjs preview",
    "test": "node --import tsx --test --test-timeout=30000 --test-force-exit ./src/**/*.spec.ts",
    "test:critical": "node --import tsx --test --test-timeout=15000 ./src/features/desktop/state/desktop-v3-sync-api.spec.ts ./src/features/desktop/state/session-snapshot-hydration.spec.ts ./src/features/desktop/state/desktop-v3-cache-normalization.spec.ts ./src/features/desktop/realtime/local-session-auth.spec.ts ./src/features/desktop/session-v3/new-session-flow.spec.ts ./src/features/desktop/session-v3/existing-session-flow.spec.ts ./src/features/desktop/session-v3/write-api.spec.ts ./src/features/desktop/chat/services/task-workspace-selection.spec.ts ./src/features/desktop/chat/services/task-command-routing.spec.ts ./src/features/desktop/chat/components/desktop-v3-task-command.spec.ts",
    "test:agents": "node --import tsx --test --test-timeout=30000 ./src/features/desktop/state/desktop-v3-task-child-view.spec.ts ./src/features/desktop/layout/sidebar-session-lineage.spec.ts ./src/features/desktop/chat/queries/agent-state-api.spec.ts"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-web": "0.79.0",
    "@rive-app/canvas": "2.39.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.166.3",
    "@tanstack/react-virtual": "3.13.23",
    "lucide-react": "0.511.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.2.2",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.18",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "esbuild": "0.28.1",
    "node": "24.16.0",
    "playwright": "1.59.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "packageManager": "pnpm@11.13.1"
}
