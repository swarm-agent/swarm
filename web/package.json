    "@tanstack/react-virtual": "3.13.23",
    "lucide-react": "0.511.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.2.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.18",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "esbuild": "0.28.1",
    "node": "24.16.0",
    "playwright": "1.59.1",
    "tsx": "4.23.1",
